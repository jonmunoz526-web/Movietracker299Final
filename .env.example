# CineMatch Environment Variables
# Copy this file to .env and fill in your API keys

# TMDB API Key — get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OMDb API Key — get one free at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Flask secret key (any random string)
SECRET_KEY=change_me_to_something_random
